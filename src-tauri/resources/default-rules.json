{
  "_README": [
    "==================================================================",
    " FERROTAG RULES",
    "==================================================================",
    "This file is OPTIONAL. Rules are applied to every loaded file when",
    "you click 'Apply Rules'. They run top to bottom; nothing is written",
    "to disk until you Save. This '_README' key is ignored — only",
    "'rules' matters.",
    "",
    "------------------------------------------------------------------",
    " OPS (the action a rule performs)",
    "------------------------------------------------------------------",
    "  trim                   remove leading/trailing whitespace",
    "                         { \"field\": \"title\", \"op\": \"trim\" }",
    "",
    "  blank                  clear the field",
    "                         { \"field\": \"genre\", \"op\": \"blank\" }",
    "",
    "  set       (value)      set the field to a fixed value",
    "                         { \"field\": \"encoded_by\", \"op\": \"set\", \"value\": \"ferrotag\" }",
    "",
    "  pad       (width)      zero-pad a number to 'width' digits",
    "                         '3' -> '03', '3/12' -> '03/12'",
    "                         non-numeric values are left untouched",
    "                         { \"field\": \"track_number\", \"op\": \"pad\", \"width\": 2 }",
    "",
    "  yearOnly               reduce a date to its first 4-digit year",
    "                         '2021-05-13' -> '2021', '13/05/2021' -> '2021'",
    "                         { \"field\": \"year\", \"op\": \"yearOnly\" }",
    "",
    "  copy      (from)       copy the value of another field into this one",
    "                         { \"field\": \"sort_artist\", \"op\": \"copy\", \"from\": \"artist\" }",
    "",
    "------------------------------------------------------------------",
    " MULTIPLE OPS ON ONE FIELD",
    "------------------------------------------------------------------",
    "Pass an array to 'op' to chain transforms. Bare strings work for",
    "ops that need no parameters; use an object for ops that do:",
    "",
    "  { \"field\": \"track_number\", \"op\": [\"trim\", { \"op\": \"pad\", \"width\": 2 }] }",
    "",
    "  { \"field\": \"sort_artist\", \"op\": [{ \"op\": \"copy\", \"from\": \"artist\" }, \"trim\"] }",
    "",
    "------------------------------------------------------------------",
    " WILDCARD FIELD",
    "------------------------------------------------------------------",
    "Use \"*\" as the field to apply an op to every field at once:",
    "",
    "  { \"field\": \"*\", \"op\": \"trim\" }",
    "",
    "Put wildcard rules first so they run before field-specific ones.",
    "",
    "------------------------------------------------------------------",
    " FIELDS",
    "------------------------------------------------------------------",
    "  title                  artist                 album",
    "  album_artist           genre                  composer",
    "  track_number           disc_number            bpm",
    "  year                   year_legacy            release_date",
    "  original_release_date  comment                description",
    "  lyricist               conductor              arranger",
    "  remixer                copyright              encoded_by",
    "  sort_title             sort_artist            sort_album",
    "  sort_album_artist",
    "",
    "------------------------------------------------------------------",
    " ACTIVE RULES",
    "------------------------------------------------------------------",
    "The 'rules' list below is empty by default — Apply Rules changes",
    "nothing until you add rules here."
  ],
  "rules": []
}
